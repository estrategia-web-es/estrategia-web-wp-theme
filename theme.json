{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "480px",
			"tablet": "782px"
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f4f4" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1a1a1a" },
				{ "slug": "muted", "name": "Muted", "color": "#5c5c5c" },
				{ "slug": "border", "name": "Border", "color": "#d6d6d6" },
				{ "slug": "primary", "name": "Primary", "color": "#1a1a1a" },
				{ "slug": "on-primary", "name": "On primary", "color": "#ffffff" },
				{ "slug": "secondary", "name": "Secondary", "color": "#4a4a4a" },
				{ "slug": "accent", "name": "Accent", "color": "#2b2b2b" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "8", "name": "8", "size": "0.5rem" },
				{ "slug": "16", "name": "16", "size": "1rem" },
				{ "slug": "24", "name": "24", "size": "1.5rem" },
				{ "slug": "32", "name": "32", "size": "2rem" },
				{ "slug": "48", "name": "48", "size": "3rem" },
				{ "slug": "64", "name": "64", "size": "4rem" },
				{ "slug": "80", "name": "80", "size": "clamp(3.5rem, 2.5rem + 3vw, 5rem)" },
				{ "slug": "120", "name": "120", "size": "clamp(4.5rem, 2.5rem + 6vw, 7.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xxx-large", "name": "3X large", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|24",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var:preset|spacing|24",
				"right": "var:preset|spacing|24"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": { "lineHeight": "1.2", "fontWeight": "700" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xxx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				},
				"border": { "radius": "4px" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var:preset|color|secondary",
						"text": "var:preset|color|on-primary"
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "navigation-overlay", "title": "Navigation overlay", "area": "navigation-overlay" }
	]
}
